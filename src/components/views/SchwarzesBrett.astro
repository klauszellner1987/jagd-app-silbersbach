---
// SchwarzesBrett.astro
---
<div id="bulletin-board" class="page">
    <div class="bulletin-board-container">
        <h2 class="bulletin-board-title">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
            </svg>
            <span>Schwarzes Brett</span>
        </h2>

        <div class="bulletin-input-wrapper">
            <textarea id="bulletin-input" placeholder="Neue Nachricht für alle... (z.B. Kanzel repariert)"></textarea>
            <button id="bulletin-submit-btn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
                Senden
            </button>
        </div>

        <div id="bulletin-list" class="bulletin-list">
            <!-- Nachrichten werden per JS geladen -->
            <div class="bulletin-loading">
                <div class="spinner"></div>
                <span>Lade Aushänge...</span>
            </div>
        </div>
    </div>
</div>
