---
// Einstellungen.astro
---
<div id="einstellungen-page" class="page">
    <div class="settings-container">
        <h2 class="settings-title">Einstellungen</h2>

        <div class="settings-section">
            <p class="settings-section-label">Konto</p>
            <button class="settings-row" id="settings-user-row" onclick="openProfileModal()">
                <div class="settings-row-left">
                    <div class="settings-row-icon" style="position: relative; overflow: hidden;">
                        <img id="settings-profile-img" src="" alt="Profilbild" style="display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;" />
                        <svg id="settings-profile-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                    </div>
                    <div style="text-align: left;">
                        <p class="settings-row-title" id="settings-username">Name eintragen</p>
                        <p class="settings-row-sub hidden" id="settings-useremail">--</p>
                    </div>
                </div>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9 18 15 12 9 6" />
                </svg>
            </button>
            <button class="settings-row logout-row" onclick="logout()">
                <div class="settings-row-left">
                    <div class="settings-row-icon danger">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                            <polyline points="16 17 21 12 16 7" />
                            <line x1="21" y1="12" x2="9" y2="12" />
                        </svg>
                    </div>
                    <span class="settings-row-title danger">Abmelden</span>
                </div>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9 18 15 12 9 6" />
                </svg>
            </button>
        </div>

        <div class="settings-section">
            <p class="settings-section-label">App Info</p>
            <div class="settings-row">
                <div class="settings-row-left">
                    <div class="settings-row-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                    </div>
                    <div>
                        <p class="settings-row-title">GJR Silbersbach</p>
                        <p class="settings-row-sub">Version <span class="app-version-text">5.0.0</span> · by Klaus Zellner</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
