---
// Dashboard.astro
---
<div id="dashboard" class="page active">

    <!-- HERO SECTION: Wetter + Begrüßung – anklickbar für Wetter Details -->
    <div class="hero-section" id="hero-section" onclick="showWetterDetails()" style="cursor: pointer;">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <p class="hero-greeting" id="hero-greeting">Willkommen</p>
            <div class="hero-weather">
                <span class="hero-temp" id="hero-temp">--°</span>
                <span class="hero-desc" id="hero-desc">Lade...</span>
            </div>
            <div class="hero-pills">
                <div class="hero-pill" id="hero-wind">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2" />
                    </svg>
                    <span id="hero-wind-text">-- km/h</span>
                </div>
                <div class="hero-pill" id="hero-sun">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 18a5 5 0 0 0-10 0" />
                        <line x1="12" y1="9" x2="12" y2="2" />
                        <line x1="4.22" y1="10.22" x2="5.64" y2="11.64" />
                        <line x1="1" y1="18" x2="3" y2="18" />
                        <line x1="21" y1="18" x2="23" y2="18" />
                        <line x1="18.36" y1="11.64" x2="19.78" y2="10.22" />
                    </svg>
                    <span id="hero-sun-text">--:--</span>
                </div>
            </div>
        </div>
    </div>

    <!-- APP GRID CARDS -->
    <div class="dashboard-content">

        <!-- 2 Square Cards -->
        <div class="app-card-grid">
            <div class="app-card nav-widget" data-target="revier">
                <div class="app-card-icon">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14.106 5.553a2 2 0 0 0 1.788 0l2.334-1.167a2 2 0 0 1 1.788 0l2.334 1.167A2 2 0 0 0 24 5.553V18.447a2 2 0 0 1-1.106 1.789l-2.334 1.167a2 2 0 0 0-1.788 0l-2.334-1.167a2 2 0 0 1-1.788 0l-2.334 1.167A2 2 0 0 0 12 18.447V5.553a2 2 0 0 1 1.106-1.789l2.334-1.167Z" />
                        <path d="m18 5.71 5.27 2.635" />
                        <path d="m18 18.29 5.27 2.635" />
                        <path d="m18 5.71v12.58" />
                    </svg>
                </div>
                <p class="app-card-title">Revier Karte</p>
                <p class="app-card-sub" id="hochsitz-count">Karte &amp; Hochsitze</p>
            </div>

            <div class="app-card nav-widget" data-target="streckenliste">
                <div class="app-card-icon">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="8" y1="6" x2="21" y2="6" />
                        <line x1="8" y1="12" x2="21" y2="12" />
                        <line x1="8" y1="18" x2="21" y2="18" />
                        <line x1="3" y1="6" x2="3.01" y2="6" />
                        <line x1="3" y1="12" x2="3.01" y2="12" />
                        <line x1="3" y1="18" x2="3.01" y2="18" />
                    </svg>
                </div>
                <p class="app-card-title">Strecke</p>
                <p class="app-card-sub" id="strecke-count">Erlegte Strecke</p>
            </div>
        </div>

        <!-- Info Row: Schwarzes Brett -->
        <div class="info-row nav-widget" data-target="bulletin-board" id="bulletin-widget">
            <div class="info-row-left">
                <div class="info-row-icon">
                    <i class="ti ti-news" style="font-size: 28px; color: white;"></i>
                </div>
                <div class="info-row-text">
                    <span class="info-row-title">Schwarzes Brett</span>
                    <span class="info-row-sub" id="bulletin-preview-text">Keine neuen Aushänge</span>
                </div>
            </div>
            <div class="info-row-right">
                <span class="bulletin-badge hidden" id="bulletin-badge">0</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9 18 15 12 9 6" />
                </svg>
            </div>
        </div>

        <!-- Info Row: Schonzeiten -->
        <div class="info-row nav-widget" data-target="schonzeit-page" id="schonzeit-widget">
            <div class="info-row-left">
                <div class="info-row-icon" id="schonzeit-icon">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20c-1.5 0-3-1-3-4.5 0-2.5 1-3.5 3-3.5s3 1 3 3.5c0 3.5-1.5 4.5-3 4.5Z" />
                        <path d="M9 14c-2-1-3-3-3-5M6 9c-1-1-2-1.5-3-1M6 9c0-2-1-3-2-3.5" />
                        <path d="M15 14c2-1 3-3 3-5M18 9c1-1 2-1.5 3-1M18 9c0-2 1-3 2-3.5" />
                    </svg>
                </div>
                <div class="info-row-text">
                    <span class="info-row-title" id="schonzeit-wildart">Schonzeiten</span>
                    <div class="info-row-sub">
                        <span id="schonzeit-status-text">Lade...</span>
                        <span id="schonzeit-datum" style="opacity: 0.6; font-size: 0.9em; margin-left: 4px;"></span>
                    </div>
                </div>
            </div>
            <div class="info-row-right">
                <div class="schonzeit-indicator" id="schonzeit-indicator"></div>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9 18 15 12 9 6" />
                </svg>
            </div>
        </div>

    </div>
</div>
