---
// Dashboard.astro
---
<div id="dashboard" class="page active">

    <!-- COMPACT HEADER -->
    <div class="dash-header" id="hero-section" onclick="showWetterDetails()">
        <div class="dash-header-left">
            <h2 class="dash-greeting" id="hero-greeting">Willkommen</h2>
            <p class="dash-subtitle">Jagdrevier Silbersbach</p>
        </div>
        <div class="dash-header-right">
            <!-- Profil Bild mit Active-Punkt -->
            <div class="profile-container" id="profile-trigger">
                <div class="profile-avatar">
                    <img id="header-profile-img" src="" alt="Profilbild" style="display: none; width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" />
                    <i class="ti ti-user" id="header-profile-icon"></i>
                    <div class="online-indicator"></div>
                </div>
                <i class="ti ti-chevron-down profile-dropdown"></i>
            </div>

            <!-- Online Users Dropdown -->
            <div id="online-users-dropdown" class="dropdown-menu hidden">
                <div class="dropdown-header">
                    <span>Mitglieder online</span>
                    <span class="online-count" id="online-count">0</span>
                </div>
                <div class="dropdown-content" id="online-users-list">
                    <div class="dropdown-loading">Lade...</div>
                </div>
            </div>
        </div>
    </div>

    <!-- QUICK LINKS SCROLL (Horizontal) -->
    <div class="quick-links-container">
        <div class="quick-links-scroll">
            <div class="quick-link nav-widget" data-target="revier">
                <div class="quick-link-icon">
                    <i class="ti ti-map-2"></i>
                </div>
                <span>Karte</span>
            </div>
            <div class="quick-link nav-widget" data-target="streckenliste">
                <div class="quick-link-icon">
                    <i class="ti ti-list-details"></i>
                </div>
                <span>Strecke</span>
            </div>
            <!-- Platzhalter für Dokumente -->
            <div class="quick-link static-card">
                <div class="quick-link-icon">
                    <i class="ti ti-file-text"></i>
                </div>
                <span>Dokus</span>
            </div>
            <div class="quick-link nav-widget" data-target="wetter-page">
                <div class="quick-link-icon">
                    <i class="ti ti-cloud"></i>
                </div>
                <span>Wetter</span>
            </div>
            <div class="quick-link nav-widget" data-target="einstellungen-page">
                <div class="quick-link-icon">
                    <i class="ti ti-settings"></i>
                </div>
                <span>Optionen</span>
            </div>
        </div>
    </div>

    <!-- Versteckte Elemente für app.js -->
    <div class="hidden">
        <span id="hero-temp">--°</span>
        <span id="hero-desc">Lade...</span>
        <span id="hero-wind-text"></span>
        <span id="hero-sun-text"></span>
    </div>

    <!-- SMART FEED -->
    <div class="smart-feed-container">
        <!-- STANDARD FEED VIEW -->
        <div id="dashboard-standard-feed">
            <h3 class="feed-section-title">Feed</h3>
            
            <!-- Feed Item: Schwarzes Brett -->
            <div class="feed-card nav-widget" data-target="bulletin-board" id="bulletin-widget">
                <div class="feed-card-header">
                    <div class="feed-card-icon-container">
                        <i class="ti ti-news"></i>
                    </div>
                    <div class="feed-card-header-text">
                        <span class="feed-card-title">Schwarzes Brett</span>
                        <span class="feed-card-time">Live</span>
                    </div>
                    <span class="bulletin-badge hidden" id="bulletin-badge">0</span>
                </div>
                <div class="feed-card-content" id="bulletin-preview">
                    <p id="bulletin-preview-text">Keine neuen Aushänge</p>
                </div>
            </div>

            <!-- Feed Item: Schonzeiten -->
            <div class="feed-card nav-widget schonzeit-widget" data-target="schonzeit-page" id="schonzeit-widget">
                <div class="feed-card-header">
                    <div class="feed-card-icon-container" id="schonzeit-icon">
                        <i class="ti ti-leaf"></i>
                    </div>
                    <div class="feed-card-header-text">
                        <span class="feed-card-title" id="schonzeit-wildart">Schonzeiten</span>
                        <span class="feed-card-time">Heute</span>
                    </div>
                    <div class="schonzeit-indicator" id="schonzeit-indicator"></div>
                </div>
                <div class="feed-card-content">
                    <p id="schonzeit-status-text">Lade...</p>
                    <p id="schonzeit-datum" style="opacity: 0.6; font-size: 0.85em; margin-top: 4px;"></p>
                </div>
            </div>

            <!-- Feed Item: Statistik / Counters -->
            <div class="feed-card static-card" onclick="toggleDashboardFeed('statistik')">
                <div class="feed-card-header">
                    <div class="feed-card-icon-container">
                        <i class="ti ti-chart-bar"></i>
                    </div>
                    <div class="feed-card-header-text">
                        <span class="feed-card-title">Revier Statistik</span>
                        <span class="feed-card-time">Gesamt</span>
                    </div>
                </div>
                <div class="feed-card-content stats-grid">
                    <div class="stat-item">
                        <span class="stat-label">Hochsitze</span>
                        <span class="stat-value" id="hochsitz-count">0</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">Rehwild</span>
                        <span class="stat-value" id="rehwild-count">0</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">Strecke</span>
                        <span class="stat-value" id="strecke-count">0</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- STRECKENLISTE FEED VIEW -->
        <div id="dashboard-strecke-feed" class="hidden">
            <div class="feed-header-inline">
                <h3 class="feed-section-title">Streckenliste</h3>
                <button class="feed-back-btn" onclick="toggleDashboardFeed('standard')">
                    <i class="ti ti-chevron-left"></i> Zurück
                </button>
            </div>
            <ul id="entry-list-dashboard" class="entry-list">
                <!-- Wird dynamisch befüllt -->
            </ul>
        </div>

        <!-- SCHONZEIT FEED VIEW -->
        <div id="dashboard-schonzeit-feed" class="hidden">
            <div class="feed-header-inline">
                <h3 class="feed-section-title">Jagdzeiten Details</h3>
                <button class="feed-back-btn" onclick="toggleDashboardFeed('standard')">
                    <i class="ti ti-chevron-left"></i> Zurück
                </button>
            </div>
            
            <!-- Filter Tabs im Feed -->
            <div class="schonzeit-tabs-inline">
                <button class="schonzeit-filter-btn active" onclick="filterSchonzeitListe('alle')">Alle</button>
                <button class="schonzeit-filter-btn" onclick="filterSchonzeitListe('jagdzeit')">Offen</button>
                <button class="schonzeit-filter-btn" onclick="filterSchonzeitListe('schonzeit')">Schonzeit</button>
            </div>

            <div id="schonzeit-liste-dashboard" class="schonzeit-liste">
                <!-- Wird dynamisch befüllt -->
            </div>
        </div>

        <!-- BULLETIN FEED VIEW -->
        <div id="dashboard-bulletin-feed" class="hidden">
            <div class="feed-header-inline">
                <h3 class="feed-section-title">Schwarzes Brett</h3>
                <button class="feed-back-btn" onclick="toggleDashboardFeed('standard')">
                    <i class="ti ti-chevron-left"></i> Zurück
                </button>
            </div>
            
            <!-- Neues Eingabefeld für Aushänge direkt im Dashboard -->
            <div class="bulletin-input-dashboard">
                <input type="text" id="bulletin-input-dashboard" placeholder="Neue Nachricht schreiben..." />
                <button id="bulletin-submit-dashboard" title="Senden">
                    <i class="ti ti-send"></i>
                </button>
            </div>

            <div id="bulletin-list-dashboard" class="bulletin-list-container">
                <!-- Wird dynamisch befüllt -->
            </div>
        </div>

        <!-- STATISTIK FEED VIEW -->
        <div id="dashboard-statistik-feed" class="hidden">
            <div class="feed-header-inline">
                <h3 class="feed-section-title">Revier Statistik</h3>
                <button class="feed-back-btn" onclick="toggleDashboardFeed('standard')">
                    <i class="ti ti-chevron-left"></i> Zurück
                </button>
            </div>

            <div class="stats-detail-container">
                <!-- Strecke Detail Card -->
                <div class="stats-detail-card">
                    <h4>Abschuss nach Wildarten</h4>
                    <div id="stats-detail-strecke">
                        <p style="opacity:0.5">Lade Daten...</p>
                    </div>
                </div>

                <!-- Rehwild Detail Card -->
                <div class="stats-detail-card">
                    <h4>Rehwild Details</h4>
                    <div id="stats-detail-rehwild">
                        <p style="opacity:0.5">Lade Daten...</p>
                    </div>
                </div>

                <!-- Bulletin Board Open Items Card -->
                <div class="stats-detail-card">
                    <h4>Offene Aufgaben</h4>
                    <div id="stats-detail-bulletin">
                        <p style="opacity:0.5">Lade Daten...</p>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
