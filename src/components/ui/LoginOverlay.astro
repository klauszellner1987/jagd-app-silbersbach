---
// LoginOverlay.astro
---
<div id="login-overlay">
    <div class="login-box">
        <!-- Branding -->
        <div class="login-branding">Jagdrevier Silbersbach</div>

        <!-- Uhrzeit & Datum -->
        <div id="clock">
            <div id="time">--:--</div>
            <div id="date">-- -- ----</div>
        </div>

        <h2>Anmelden</h2>

        <!-- Login Formular -->
        <form id="login-form" class="login-form">
            <div class="input-group">
                <input type="email" id="login-email" placeholder="E-Mail" autocomplete="email" required>
            </div>
            <div class="input-group password-group">
                <input type="password" id="login-password" placeholder="Passwort" autocomplete="current-password" required>
                <button type="button" class="password-toggle" id="password-toggle" aria-label="Passwort anzeigen">
                    <svg class="eye-open" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <svg class="eye-closed hidden" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                        <line x1="1" y1="1" x2="23" y2="23"></line>
                    </svg>
                </button>
            </div>
            <button type="submit" class="login-btn">Einloggen</button>
        </form>

        <p id="login-error" class="hidden">Login fehlgeschlagen. Bitte prüfe deine Zugangsdaten.</p>

        <div class="login-loading hidden" id="login-loading">
            <div class="spinner"></div>
            <span>Anmelden...</span>
        </div>

        <div class="login-footer">
            <span id="app-version">v5.0.0</span>
            <span class="login-footer-divider">•</span>
            <span>by Klaus Zellner</span>
        </div>
    </div>
</div>
