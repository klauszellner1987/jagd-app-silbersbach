---
// Navigation.astro
---
<nav id="bottom-nav" class="bottom-nav hidden">
    <!-- SVG Background mit Halbkreis-Cutout -->
    <div class="nav-bg-shape">
        <svg viewBox="0 0 375 70" preserveAspectRatio="none" width="100%" height="100%">
            <path d="M0,0 L135,0 C140,0 145,5 147,12 C154,32 168,44 187.5,44 C207,44 221,32 228,12 C230,5 235,0 240,0 L375,0 L375,70 L0,70 Z" fill="rgba(25, 40, 28, 0.95)" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
        </svg>
    </div>
    
    <div class="nav-content">
        <!-- Ein zentraler Home-Button, der in den Cutout ragt -->
        <button class="nav-fab" onclick="navigateToDashboard()">
            <i class="ti ti-home"></i>
        </button>
    </div>
</nav>
